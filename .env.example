# todayaihot 环境变量配置模板
# 复制为 .env 并填入实际值；.env 已加入 .gitignore，不会提交

# ---- 密钥（代码中不再硬编码）----
# 火山引擎 seed-tts-2.0 API Key（缺失时 auto 后端自动降级 edge-tts）
VOLC_TTS_API_KEY=

# Pexels 实拍图 API Key（缺失时跳过 Pexels 兜底，只用原文图+关键词海报卡）
PEXELS_API_KEY=

# ---- TTS 可选覆盖 ----
# edge-tts 音色（默认 zh-CN-YunxiNeural 云希）
# TTS_EDGE_VOICE=zh-CN-XiaoxiaoNeural

# 火山 TTS 音色（默认 zh_female_sophie_uranus_bigtts）
# VOLC_TTS_VOICE=zh_female_sophie_uranus_bigtts

# edge-tts 单句合成超时秒数（默认 60）
# TTS_EDGE_TIMEOUT=60

# ---- GPT-SoVITS（可选，本地克隆音色）----
# GSV_API=http://127.0.0.1:9880
# GSV_REGISTRY=E:\code\GPT-SoVITS\voice\cloned_voices.json
# GSV_VOICE=

# ---- 路径（通常不需要改）----
# 项目根目录（remotion/work/out 所在目录）
# TODAYAIHOT_ROOT=E:\workbuddy-workspace\todaynew
